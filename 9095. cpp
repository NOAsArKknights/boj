#include<stdio.h>

int arr[30];

int main()
{
    int i,n,t;
    
    scanf("%d",&t);
    
    arr[1]=1;
    arr[2]=2;
    arr[3]=4;
    
    for(i=4;i<=11;i++){
        arr[i]=arr[i-1]+arr[i-2]+arr[i-3];    
    }    
    
    while(t--){
        scanf("%d",&n);
        printf("%d\n",arr[n]);
    }
    
    return 0;
}
